{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duet",
  "version": "0.3.1",
  "identifier": "local.claude-desk.native",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
