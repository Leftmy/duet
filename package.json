{
  "name": "duet",
  "productName": "Duet",
  "version": "0.1.0",
  "description": "Desktop UI for coding agents",
  "homepage": "https://localhost/duet",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p .",
    "test:chat": "node scripts/test-chat-lifecycle.mjs",
    "test:antigravity": "node --test scripts/test-antigravity.mjs",
    "test:gemini": "node --test scripts/test-gemini.mjs",
    "icon": "node scripts/make-icon.mjs",
    "shortcut": "node scripts/make-shortcut.mjs",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win nsis",
    "dist:linux": "vite build && electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.291",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "build": {
    "appId": "local.claude-desk",
    "productName": "Duet",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "node_modules/node-pty/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Duet",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "npmRebuild": false,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "executableName": "duet",
      "synopsis": "Desktop UI for coding agents",
      "desktop": {
        "entry": {
          "StartupWMClass": "Duet"
        }
      },
      "maintainer": "Duet <duet@localhost>"
    },
    "appImage": {
      "artifactName": "Duet-${version}-${arch}.AppImage"
    }
  }
}
